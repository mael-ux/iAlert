# Copy to .env and fill in real values. Never commit .env.
# Required at Expo start: the app reads this in mobile/app/_layout.jsx
# and will not start without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Backend API base URL.
# Production default is kept in code (mobile/constants/api.js);
# set this only to override — e.g. your machine's LAN IP for device testing.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5001/api

# AI service base URL.
# Production default is kept in code (mobile/constants/api.js);
# set this only to override for local AI service testing.
# EXPO_PUBLIC_AI_API_URL=http://192.168.1.10:8000
