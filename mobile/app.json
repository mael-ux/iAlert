{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "192.168.100.242": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSLocationWhenInUseUsageDescription": "We need your location to show you the current weather.",
        "NSLocationAlwaysUsageDescription": "Allow $(PRODUCT_NAME) to use your location."
      },
      "bundleIdentifier": "com.anahiramirez.ialert"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anahiramirez.ialert"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  [
    "expo-notifications",
    {
      "icon": "./assets/images/icon.png",
      "color": "#740000",
      "sounds": [
        "./assets/sounds/alert.mp3"
      ]
    }
  ],
  "expo-router",
  [
    "expo-splash-screen",
    {
      "backgroundColor": "#050B18"
    }
  ],
  "expo-asset",
  [
    "expo-location",
    {
      "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
    }
  ],
  "expo-secure-store",
  [
    "expo-camera",
    {
      "cameraPermission": "Permitir que $(PRODUCT_NAME) acceda a la cámara para activar el flash en alertas de emergencia."
    }
  ],
  "expo-font",
  "expo-image",
  "expo-status-bar",
  "expo-web-browser",
  "expo-audio"
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c30815d-9ec3-4045-bef3-47c0256e3c8d"
      }
    }
  }
}
