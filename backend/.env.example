# Copy to .env and fill in real values. Never commit .env.
# Names match backend/src/config/env.js exactly.

# Server port (env.js default: 5001)
PORT=5001

# Postgres connection string (required — env.js warns if missing)
DATABASE_URL=postgresql://user:password@localhost:5432/ialert

# development | production (env.js default: development)
NODE_ENV=development

# OpenWeather API key (required — env.js warns if missing)
OPENWEATHER_API_KEY=your-openweather-api-key

# Clerk webhook signing secret (required for webhooks — env.js warns if missing)
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret

# Public API base URL.
# In production env.js uses API_URL or defaults to https://ialert.onrender.com/api.
# In development env.js uses API_URL or defaults to http://localhost:<PORT>/api.
API_URL=http://localhost:5001/api
